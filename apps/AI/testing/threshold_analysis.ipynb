    "\n",
    "# Threshold lines\n",
    "ax.axvline(T1*100, color=COLORS['youden'], linewidth=2, linestyle='--',\n",
    "           label=f\"T1 = {T1*100:.1f}% (Youden's J)\")\n",
    "ax.axvline(T2*100, color=COLORS['recall'], linewidth=2, linestyle='--',\n",
