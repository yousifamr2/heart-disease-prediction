# Artemis AI Backend - Environment Variables

# Security
INTERNAL_API_KEY=your_secure_internal_api_key_here

# HuggingFace Model API (Fallback to local if unavailable)
HF_PREDICT_API_URL=https://omarbm52-artemis-heart-api.hf.space/predict

# LLM Provider (Groq)
GROQ_API_KEY=your_groq_api_key_here

# Allowed Hosts for CORS/Middleware
AI_ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=heart_disease
DB_HOST=db
DB_PORT=5432
